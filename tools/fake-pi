def run(message):
    emit({"type": "agent_start"})
    emit({"type": "turn_start"})
    shown = message
    if message.startswith("/skill:"):
        # Pi echoes a skill command expanded, like this.
        name, _, rest = message[7:].partition(" ")
        shown = f'<skill name="{name}" location="SKILL.md">\n…instructions…\n</skill>\n\n{rest}'
    emit({"type": "message_start", "message": {"role": "user", "content": shown}})
    emit({"type": "message_end", "message": {"role": "user", "content": shown}})
    if message.startswith("Find"):
        subagent_turn()
    elif message.startswith("Fail"):
        error_turn()
    elif message.startswith("Approve"):
        emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
        sub = "run-" + "-".join(["a-very-long-script-name"] * 6)
        tool(0, "a-bash", "bash", {"command": f"npm {sub} --workspace /Users/someone/Workspace/project/packages/app"}, "ok")
        emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "stop"}})
    elif message.startswith("Table"):
        emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
        say(0, "Here's how the three diff libraries compare:\n\n"
               "| Crate | Algorithm | Size | Last release |\n| --- | --- | --- | --- |\n"
               "| `similar` | Myers, Patience | 96 KB | 2024-11-03 |\n"
               "| `imara-diff` | Histogram, Myers | 54 KB | 2025-02-17 |\n"
               "| `diffy` | Myers | 41 KB | 2023-08-29 |\n\nI'd pick `imara-diff`.", pause=0)
        emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "stop"}})
    elif message.startswith("Code"):
