for line in sys.stdin:
    try:
        req = json.loads(line)
    except ValueError:
        continue
    kind = req.get("type")
    if kind == "extension_ui_response":
        slot = pending.get(req.get("id"))
        if slot:
            slot["value"] = None if req.get("cancelled") else req.get("value")
            slot["event"].set()
    elif kind == "get_state":
        respond(req, {"model": state["model"], "thinkingLevel": state["thinking"], "isStreaming": False,
                      "sessionFile": recorder.path})
    elif kind == "get_available_models":
        respond(req, {"models": MODELS})
    elif kind == "set_model":
        state["model"] = next((m for m in MODELS if m["id"] == req.get("modelId")), state["model"])
        respond(req, state["model"])
    elif kind == "set_thinking_level":
        state["thinking"] = req.get("level", "high")
        respond(req)
    elif kind == "get_session_stats":
        respond(req, {"contextUsage": {"tokens": 48200 if state["tokens"] > 4000 else 21700,
                                       "contextWindow": 200000, "percent": 24}})
    elif kind == "prompt" and req.get("message", "").startswith("/treehouse-save "):
        # The bridge extension's command: saves what Treehouse shows.
        saved = json.loads(req["message"].split(" ", 1)[1])
        with out_lock:
            recorder.custom(saved["customType"], saved.get("data"))
        respond(req, {"disposition": "handled"})
    elif kind == "prompt" and req.get("message", "").startswith("/mcp login "):
        respond(req, {"disposition": "handled"})
        threading.Thread(target=mcp_login, args=(req["message"].split()[2],), daemon=True).start()
    elif kind == "prompt":
        respond(req, {"disposition": "started"})
        threading.Thread(target=run, args=(req.get("message", ""),), daemon=True).start()
    elif kind == "get_commands":
        respond(req, {"commands": COMMANDS})
    elif kind == "compact":
        def compact():
            emit({"type": "compaction_start", "reason": "manual"})
            time.sleep(1.5)
            result = {"summary": "…", "tokensBefore": 182000, "estimatedTokensAfter": 41000}
            emit({"type": "compaction_end", "reason": "manual", "result": result, "aborted": False, "willRetry": False})
            respond(req, result)
        threading.Thread(target=compact, daemon=True).start()
    elif kind == "new_session":
        state["tokens"] = 0
        with out_lock:
            recorder.new()
        respond(req, {"cancelled": False})
    elif kind == "bash":
        threading.Thread(target=user_bash, args=(req,), daemon=True).start()
    elif kind == "abort_bash":
        for proc in list(shells):
            proc.terminate()
        respond(req)
    elif kind == "abort":
        respond(req)
    else:
        respond(req, {})
