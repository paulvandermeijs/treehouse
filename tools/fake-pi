#!/usr/bin/env python3
"""A stand-in for `pi --mode rpc` that plays back a scripted turn.

Treehouse talks to it exactly as it talks to Pi, so it is handy for working
on the chat UI without a model or an API key:

    Settings › Agent defaults › Pi command: /path/to/treehouse/tools/fake-pi

A message that starts with "Find" plays the sub-agent script, "Fail" a
provider error with a stack trace, and "Approve" a command with a long approval
pattern, "Long" a long-running command with a
long command line; anything else plays the worktree chat script, which starts
a sub-agent. Set FAKE_PI_HOLD to
the number of seconds the sub-agent keeps working before it reports back.

Set FAKE_PI_MCP to report a "figma" MCP server that needs a sign-in when
Pi starts. `/mcp login <server>` then plays Pi's sign-in: pasting any address
signs in, one containing "fail" fails, and cancelling cancels.
"""

import json
import os
import sys
import threading
import time
import uuid

out_lock = threading.Lock()
pending = {}


def emit(obj):
    with out_lock:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()


def respond(req, data=None):
    msg = {"type": "response", "command": req["type"], "success": True}
    if "id" in req:
        msg["id"] = req["id"]
    if data is not None:
        msg["data"] = data
    emit(msg)


MODELS = [
    {"id": "claude-opus-4-5", "name": "Claude Opus 4.5", "provider": "anthropic", "contextWindow": 200000},
    {"id": "claude-sonnet-4-5", "name": "Claude Sonnet 4.5", "provider": "anthropic", "contextWindow": 200000},
]
COMMANDS = [
    {"name": "skill:pdf-tools", "description": "Extract text and tables from PDF files", "source": "skill",
     "sourceInfo": {"path": "/home/you/.pi/agent/skills/pdf-tools/SKILL.md", "scope": "user"}},
    {"name": "skill:frontend-design", "description": "Build distinctive, production-grade web interfaces",
     "source": "skill", "sourceInfo": {"path": "/home/you/.agents/skills/frontend-design/SKILL.md", "scope": "user"}},
    {"name": "review", "description": "Review staged git changes", "source": "prompt",
     "sourceInfo": {"path": "/home/you/.pi/agent/prompts/review.md", "scope": "user"}},
    {"name": "fix-tests", "description": "Fix failing tests", "source": "prompt",
     "sourceInfo": {"path": "/home/you/.pi/agent/prompts/fix-tests.md", "scope": "user"}},
]
state = {"model": MODELS[0], "thinking": "high", "tokens": 0}


def ask(title, payload):
    """Sends an extension UI input request and waits for the answer."""
    rid = str(uuid.uuid4())
    event = threading.Event()
    pending[rid] = {"event": event, "value": None}
    request = {"type": "extension_ui_request", "id": rid, "method": "input", "title": title}
    if payload:
        request["placeholder"] = json.dumps(payload)
    emit(request)
    event.wait()
    return pending.pop(rid)["value"]


def notify(message, kind="info"):
    emit({"type": "extension_ui_request", "id": str(uuid.uuid4()), "method": "notify",
          "message": message, "notifyType": kind})


def mcp_login(server):
    """Plays Pi's `/mcp login`: browser link, then a wait for the redirect."""
    notify(f'Sign in to MCP server "{server}" in your browser:\n'
           f"https://www.figma.com/oauth?client_id=treehouse&redirect_uri=http%3A%2F%2F127.0.0.1%3A53682%2Fcallback")
    redirect = ask(f'Waiting for sign-in to "{server}". If the browser cannot reach this machine, '
                   "paste the URL it was redirected to.", {})
    if not redirect:
        notify("Sign-in cancelled.")
    elif "fail" in redirect:
        notify(f"Couldn't sign in to \"{server}\": the authorization code has expired.", "error")
    else:
        notify(f'Signed in to MCP server "{server}" (12 tools).')


def update(ev):
    state["tokens"] += 180
    emit({"type": "message_update", "usage": {"totalTokens": state["tokens"]}, "assistantMessageEvent": ev})


def say(index, text, pause=0.02):
    update({"type": "text_start", "contentIndex": index})
    for word in text.split(" "):
        update({"type": "text_delta", "contentIndex": index, "delta": word + " "})
        time.sleep(pause)
    update({"type": "text_end", "contentIndex": index, "content": text})


def think(index, text):
    update({"type": "thinking_start", "contentIndex": index})
    update({"type": "thinking_delta", "contentIndex": index, "delta": text})
    time.sleep(0.4)
    update({"type": "thinking_end", "contentIndex": index, "content": text})


def tool(index, call_id, name, args, result, is_error=False, partial=None, hold=0.0):
    update({"type": "toolcall_start", "contentIndex": index, "id": call_id, "toolName": name})
    update({"type": "toolcall_end", "contentIndex": index,
            "toolCall": {"type": "toolCall", "id": call_id, "name": name, "arguments": args}})
    answer = ask("treehouse:approval", {"toolCallId": call_id, "toolName": name, "input": args, "cwd": os.getcwd()})
    if answer != "allow":
        emit({"type": "tool_execution_start", "toolCallId": call_id, "toolName": name, "args": args})
        emit({"type": "tool_execution_end", "toolCallId": call_id, "toolName": name, "isError": True,
              "result": {"content": [{"type": "text", "text": answer[5:] if answer else "Denied"}]}})
        return False
    emit({"type": "tool_execution_start", "toolCallId": call_id, "toolName": name, "args": args})
    started = time.time()
    if partial:
        emit({"type": "tool_execution_update", "toolCallId": call_id, "toolName": name, "args": args,
              "partialResult": {"content": [{"type": "text", "text": partial}]}})
    time.sleep(hold)
    content, details = result if isinstance(result, tuple) else (result, None)
    end = {"type": "tool_execution_end", "toolCallId": call_id, "toolName": name, "isError": is_error,
           "result": {"content": [{"type": "text", "text": content}]},
           "durationMs": int((time.time() - started) * 1000) + 40}
    if details:
        end["result"]["details"] = details
    emit(end)
    return True


PATCH = """--- a/src/worktree.rs
+++ b/src/worktree.rs
@@ -12,4 +12,6 @@ pub struct Worktree {
     pub branch: String,
-    pub status: Option<String>,
+    pub base: String,
+    pub diff: Entity<DiffState>,
+    pub sub_agents: Vec<SubAgentId>,
 }
"""

DIFFSTAT = """ src/app.rs       | 70 ++++++++++++++++---------
 src/diff/pane.rs | 86 +++++++++++++++++++++++++++++
 src/worktree.rs  | 24 ++++++---
 3 files changed, 142 insertions(+), 38 deletions(-)"""


def worktree_turn():
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    think(0, "The diff needs the worktree's base. Check how Worktree holds state, then split out the component survey.")
    say(1, "I'll check how worktree state is held first, then start a sub-agent to map which gpui-kit components fit a diff view.")
    tool(2, "c-read", "read", {"path": "src/worktree.rs"}, "pub struct Worktree {\n" + "    ...\n" * 211)
    tool(3, "c-bash", "bash", {"command": "git diff --stat main...HEAD"}, DIFFSTAT)
    tool(4, "c-edit", "edit", {"path": "src/worktree.rs", "edits": [{"oldText": "status", "newText": "base"}]},
         ("Successfully replaced 1 block(s) in src/worktree.rs.", {"diff": "", "patch": PATCH}))
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "toolUse"}})
    emit({"type": "turn_end"})
    emit({"type": "turn_start"})
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    say(0, "While that runs I've updated `Worktree` to hold its diff state and handed the survey to a sub-agent.")
    call_id = "c-sub"
    args = {"title": "Explore gpui-kit components",
            "task": "Find the gpui-kit components for a split pane, file tree and code view, and note their props. "
                    "Report back with a short recommendation."}
    update({"type": "toolcall_start", "contentIndex": 1, "id": call_id, "toolName": "subagent"})
    update({"type": "toolcall_end", "contentIndex": 1, "toolCall": {"id": call_id, "name": "subagent", "arguments": args}})
    ask("treehouse:approval", {"toolCallId": call_id, "toolName": "subagent", "input": args, "cwd": os.getcwd()})
    emit({"type": "tool_execution_start", "toolCallId": call_id, "toolName": "subagent", "args": args})
    report = ask("treehouse:subagent", dict(toolCallId=call_id, cwd=os.getcwd(), **args))
    emit({"type": "tool_execution_end", "toolCallId": call_id, "toolName": "subagent", "isError": report is None,
          "result": {"content": [{"type": "text", "text": report or "stopped"}]}})
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "toolUse"}})
    emit({"type": "turn_end"})
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    say(0, "The sub-agent recommends **Resizable** for the split and **Diff** for the code view. Want me to wire them in?")
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "stop"}})


def subagent_turn():
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    tool(0, "s-rg", "bash", {"command": 'rg -l "pub struct" gpui-kit/src'},
         "src/resizable.rs\nsrc/tree.rs\nsrc/editor/mod.rs\nsrc/scroll.rs\n…14 more")
    tool(1, "s-r1", "read", {"path": "src/resizable.rs"}, "x\n" * 140)
    tool(2, "s-r2", "read", {"path": "src/tree.rs"}, "x\n" * 145)
    say(3, "So far:\n\n- `Resizable` handles the split, with a draggable handle and min sizes per side.\n"
           "- `Tree` fits the changed-files list; nodes take an icon and a trailing slot.\n"
           "- Still checking whether the editor supports per-line backgrounds.")
    tool(4, "s-r3", "read", {"path": "src/editor/mod.rs"}, "x\n" * 300, hold=float(os.environ.get("FAKE_PI_HOLD", "4")))
    say(5, "Use `Resizable` for the split and `Diff` for the code view: it already colours added and removed lines.")
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "stop"}})


def error_turn():
    stack = "\n".join(
        f"    at async step{i} (file:///Users/someone/.vite-plus/js_runtime/node/24.22.1/lib/node_modules/"
        f"@earendil-works/pi-coding-agent/dist/bundle/chunks/chunk-N43LRJ4N.js:3:{38000 + i})"
        for i in range(8))
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "error",
          "errorMessage": "OAuth refresh failed for anthropic: Anthropic token refresh request failed. "
                          "url=https://platform.claude.com/v1/oauth/token; details=Error: HTTP request failed. status=400\n" + stack}})


def long_command_turn():
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    command = 'for i in {1..500}; do echo "Processing log line $i: Running a verbose operation."; sleep 0.01; done'
    output = "\n".join(f"Processing log line {i}: Running a verbose operation." for i in range(1, 139))
    tool(0, "l-bash", "bash", {"command": command}, output, partial=output,
         hold=float(os.environ.get("FAKE_PI_HOLD", "4")))
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "stop"}})


def run(message):
    emit({"type": "agent_start"})
    emit({"type": "turn_start"})
    shown = message
    if message.startswith("/skill:"):
        # Pi echoes a skill command expanded, like this.
        name, _, rest = message[7:].partition(" ")
        shown = f'<skill name="{name}" location="SKILL.md">\n…instructions…\n</skill>\n\n{rest}'
    emit({"type": "message_start", "message": {"role": "user", "content": shown}})
    emit({"type": "message_end", "message": {"role": "user", "content": shown}})
    if message.startswith("Find"):
        subagent_turn()
    elif message.startswith("Fail"):
        error_turn()
    elif message.startswith("Approve"):
        emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
        sub = "run-" + "-".join(["a-very-long-script-name"] * 6)
        tool(0, "a-bash", "bash", {"command": f"npm {sub} --workspace /Users/someone/Workspace/project/packages/app"}, "ok")
        emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "stop"}})
    elif message.startswith("Long"):
        long_command_turn()
    elif message.startswith("/"):
        emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
        say(0, "Done: I followed the command.")
        emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "stop"}})
    else:
        worktree_turn()
    emit({"type": "turn_end"})
    emit({"type": "agent_end", "willRetry": False})
    emit({"type": "agent_settled", "aborted": False})


if os.environ.get("FAKE_PI_MCP"):
    notify("MCP servers need attention:\n  figma: needs sign-in\nRun /mcp to fix.", "warning")

for line in sys.stdin:
    try:
        req = json.loads(line)
    except ValueError:
        continue
    kind = req.get("type")
    if kind == "extension_ui_response":
        slot = pending.get(req.get("id"))
        if slot:
            slot["value"] = None if req.get("cancelled") else req.get("value")
            slot["event"].set()
    elif kind == "get_state":
        respond(req, {"model": state["model"], "thinkingLevel": state["thinking"], "isStreaming": False,
                      "sessionFile": "/tmp/fake-pi-session.jsonl"})
    elif kind == "get_available_models":
        respond(req, {"models": MODELS})
    elif kind == "set_model":
        state["model"] = next((m for m in MODELS if m["id"] == req.get("modelId")), state["model"])
        respond(req, state["model"])
    elif kind == "set_thinking_level":
        state["thinking"] = req.get("level", "high")
        respond(req)
    elif kind == "get_session_stats":
        respond(req, {"contextUsage": {"tokens": 48200 if state["tokens"] > 4000 else 21700,
                                       "contextWindow": 200000, "percent": 24}})
    elif kind == "prompt" and req.get("message", "").startswith("/mcp login "):
        respond(req, {"disposition": "handled"})
        threading.Thread(target=mcp_login, args=(req["message"].split()[2],), daemon=True).start()
    elif kind == "prompt":
        respond(req, {"disposition": "started"})
        threading.Thread(target=run, args=(req.get("message", ""),), daemon=True).start()
    elif kind == "get_commands":
        respond(req, {"commands": COMMANDS})
    elif kind == "compact":
        def compact():
            emit({"type": "compaction_start", "reason": "manual"})
            time.sleep(1.5)
            result = {"summary": "…", "tokensBefore": 182000, "estimatedTokensAfter": 41000}
            emit({"type": "compaction_end", "reason": "manual", "result": result, "aborted": False, "willRetry": False})
            respond(req, result)
        threading.Thread(target=compact, daemon=True).start()
    elif kind == "new_session":
        state["tokens"] = 0
        respond(req, {"cancelled": False})
    elif kind == "abort":
        respond(req)
    else:
        respond(req, {})
