shells = []


def user_bash(req):
    """Pi's `bash` command: runs what the user typed after `!`."""
    proc = subprocess.Popen(["bash", "-c", req.get("command", "")], stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True)
    shells.append(proc)
    output = ""
    for line in proc.stdout:
        output += line
        emit({"type": "bash_execution_update", "id": req.get("id"), "delta": line})
    code = proc.wait()
    shells.remove(proc)
    cancelled = code < 0
    result = {"output": output, "exitCode": None if cancelled else code,
              "cancelled": cancelled, "truncated": False}
    with out_lock:
        recorder.write({"role": "bashExecution", "command": req.get("command", ""),
                        "excludeFromContext": req.get("excludeFromContext", False), **result})
    respond(req, result)


