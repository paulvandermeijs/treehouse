def worktree_turn():
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    think(0, "The diff needs the worktree's base. Check how Worktree holds state, then split out the component survey.")
    say(1, "I'll check how worktree state is held first, then start a sub-agent to map which gpui-kit components fit a diff view.")
    tool(2, "c-read", "read", {"path": "src/worktree.rs"}, "pub struct Worktree {\n" + "    ...\n" * 211)
    tool(3, "c-bash", "bash", {"command": "git diff --stat main...HEAD"}, DIFFSTAT)
    tool(4, "c-edit", "edit", {"path": "src/worktree.rs", "edits": [{"oldText": "status", "newText": "base"}]},
         ("Successfully replaced 1 block(s) in src/worktree.rs.", {"diff": "", "patch": PATCH}))
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "toolUse"}})
    emit({"type": "turn_end"})
    emit({"type": "turn_start"})
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    say(0, "While that runs I've updated `Worktree` to hold its diff state and handed the survey to a sub-agent.")
    call_id = "c-sub"
    args = {"title": "Explore gpui-kit components",
            "task": "Find the gpui-kit components for a split pane, file tree and code view, and note their props. "
                    "Report back with a short recommendation."}
    update({"type": "toolcall_start", "contentIndex": 1, "id": call_id, "toolName": "subagent"})
    update({"type": "toolcall_end", "contentIndex": 1, "toolCall": {"id": call_id, "name": "subagent", "arguments": args}})
    ask("treehouse:approval", {"toolCallId": call_id, "toolName": "subagent", "input": args, "cwd": os.getcwd()})
    emit({"type": "tool_execution_start", "toolCallId": call_id, "toolName": "subagent", "args": args})
    report = ask("treehouse:subagent", dict(toolCallId=call_id, cwd=os.getcwd(), **args))
    emit({"type": "tool_execution_end", "toolCallId": call_id, "toolName": "subagent", "isError": report is None,
          "result": {"content": [{"type": "text", "text": report or "stopped"}]}})
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "toolUse"}})
    emit({"type": "turn_end"})
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    say(0, "The sub-agent recommends **Resizable** for the split and **Diff** for the code view. Want me to wire them in?")
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "stop"}})


def base_branch():
    note = arg("--append-system-prompt") or ""
    marker = "base branch is "
    return note.split(marker, 1)[1].rstrip(".") if marker in note else "main"


def shell_tool(index, call_id, command):
    """A bash tool call that really runs, as Pi's does."""
    update({"type": "toolcall_start", "contentIndex": index, "id": call_id, "toolName": "bash"})
    args = {"command": command}
    update({"type": "toolcall_end", "contentIndex": index,
            "toolCall": {"type": "toolCall", "id": call_id, "name": "bash", "arguments": args}})
    answer = ask("treehouse:approval", {"toolCallId": call_id, "toolName": "bash", "input": args, "cwd": os.getcwd()})
    emit({"type": "tool_execution_start", "toolCallId": call_id, "toolName": "bash", "args": args})
    if answer != "allow":
        emit({"type": "tool_execution_end", "toolCallId": call_id, "toolName": "bash", "isError": True,
              "result": {"content": [{"type": "text", "text": answer[5:] if answer else "Denied"}]}})
        return None
    proc = subprocess.run(["bash", "-c", command], capture_output=True, text=True)
    output = (proc.stdout + proc.stderr).strip()
    if proc.returncode:
        output += f"\n\nCommand exited with code {proc.returncode}"
    emit({"type": "tool_execution_end", "toolCallId": call_id, "toolName": "bash", "isError": proc.returncode != 0,
          "result": {"content": [{"type": "text", "text": output or "(no output)"}]}})
    return proc.returncode == 0


def commit_steps(start, run_id):
    """Commits whatever is uncommitted; returns the next content index."""
    dirty = subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True).stdout.strip()
    if not dirty:
        return start
    shell_tool(start, f"lc-status-{run_id}", "git status --porcelain")
    shell_tool(start + 1, f"lc-commit-{run_id}",
               "git add -A && git commit -q -m 'feat: save the work so far' -m 'Committed by fake-pi.'")
    return start + 2


def lifecycle_turn(skill):
    base = base_branch()
    # Pi's tool call ids are unique; repeated runs must not reuse them.
    run_id = uuid.uuid4().hex[:6]
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    index = 0
    if skill in ("commit", "finish-branch"):
        index = commit_steps(0, run_id)
    if skill == "commit":
        say(index, "Committed the work so far." if index else "Nothing to commit.")
    if skill in ("sync", "finish-branch"):
        behind = subprocess.run(["git", "rev-list", "--count", f"HEAD..{base}"], capture_output=True, text=True).stdout.strip()
        if behind not in ("", "0"):
            shell_tool(index, f"lc-rebase-{run_id}", f"git rebase {base}")
            index += 1
        elif skill == "sync":
            say(index, f"Already up to date with {base}.")
            index += 1
    if skill == "setup-worktrees":
        shell_tool(index, f"lc-ignored-{run_id}", "git status --ignored --short")
        shell_tool(index + 1, f"lc-write-{run_id}",
                   "mkdir -p .agents && printf '# Secrets and local settings, the same in every worktree\\n.env\\n' > .agents/linked"
                   " && printf '#!/bin/sh\\nset -e\\necho \"Preparing $(basename \"$PWD\")\"\\n' > .agents/prepare"
                   " && chmod +x .agents/prepare && sh -n .agents/prepare")
        say(index + 2, "New worktrees now share `.env` with the main worktree, and `.agents/prepare` runs in each. Commit both to the main branch for them to apply.")
        index += 3
    if skill == "finish-branch":
        call_id = f"lc-finish-{run_id}"
        args = {"squash_message": "feat: finish the branch"}
        update({"type": "toolcall_start", "contentIndex": index, "id": call_id, "toolName": "treehouse_merge"})
        update({"type": "toolcall_end", "contentIndex": index,
                "toolCall": {"type": "toolCall", "id": call_id, "name": "treehouse_merge", "arguments": args}})
        ask("treehouse:approval", {"toolCallId": call_id, "toolName": "treehouse_merge", "input": args, "cwd": os.getcwd()})
        emit({"type": "tool_execution_start", "toolCallId": call_id, "toolName": "treehouse_merge", "args": args})
        answer = ask("treehouse:merge", {"toolCallId": call_id, "squashMessage": args["squash_message"], "cwd": os.getcwd()})
        outcome = json.loads(answer) if answer else {"text": "The merge was stopped before it finished.", "merged": None}
        end = {"type": "tool_execution_end", "toolCallId": call_id, "toolName": "treehouse_merge",
               "isError": not outcome.get("merged"), "result": {"content": [{"type": "text", "text": outcome["text"]}]}}
        if outcome.get("merged"):
            end["result"]["details"] = {"merged": outcome["merged"]}
        emit(end)
        say(index + 1, outcome["text"])
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "stop"}})


def worktree_turn_for_pi():
    """Asks Treehouse for a new worktree and hands it the task."""
    emit({"type": "message_start", "message": {"role": "assistant", "content": [], "stopReason": "pending"}})
    say(0, "I'll start a worktree for it and hand it the task, so the page is built there.")
    call_id = f"wt-{uuid.uuid4().hex[:6]}"
    args = {"branch": f"about-page-{call_id[3:]}",
            "task": "Table of the diff libraries, for the about page."}
    update({"type": "toolcall_start", "contentIndex": 1, "id": call_id, "toolName": "treehouse_worktree"})
    update({"type": "toolcall_end", "contentIndex": 1,
            "toolCall": {"type": "toolCall", "id": call_id, "name": "treehouse_worktree", "arguments": args}})
    ask("treehouse:approval", {"toolCallId": call_id, "toolName": "treehouse_worktree", "input": args, "cwd": os.getcwd()})
    emit({"type": "tool_execution_start", "toolCallId": call_id, "toolName": "treehouse_worktree", "args": args})
    answer = ask("treehouse:worktree", {"toolCallId": call_id, "branch": args["branch"], "task": args["task"], "cwd": os.getcwd()})
    outcome = json.loads(answer) if answer else {"text": "The worktree wasn't created.", "worktree": None}
    end = {"type": "tool_execution_end", "toolCallId": call_id, "toolName": "treehouse_worktree",
           "isError": not outcome.get("worktree"), "result": {"content": [{"type": "text", "text": outcome["text"]}]}}
    if outcome.get("worktree"):
        end["result"]["details"] = {"worktree": outcome["worktree"]}
    emit(end)
    say(2, outcome["text"])
    emit({"type": "message_end", "message": {"role": "assistant", "stopReason": "stop"}})


